# Raiz — Sistema DEZ
/root .env* (segredos locais do compose raiz, se existirem)
*.dump
*.sql

# Backend (Laravel) — espelha backend/.gitignore
backend/vendor/
backend/node_modules/
backend/.env
backend/.env.backup
backend/.env.production
backend/public/build
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/pail/
backend/.phpunit.cache/
backend/.phpunit.result.cache
backend/compose.local.yaml

# Frontend (Vite/pnpm)
frontend/node_modules/
frontend/**/node_modules/
frontend/**/dist/
frontend/**/.vite/
frontend/storybook-static/
frontend/playwright-report/
frontend/test-results/
frontend/.env.local

# Deploy (o .env de produção vive só no servidor)
deploy/.env.production
deploy/**/*.local
# exceção: o SQL de provisionamento É versionado de propósito (a regra *.sql
# acima existe para não versionar dumps; sem esta linha o arquivo era ignorado
# em silêncio e o servidor não o encontrava).
!deploy/sql/*.sql

# OS / editores
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
