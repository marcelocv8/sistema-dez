# Ambiente de produção do Sistema DEZ — servidor da Clínica DEZ.
# Copiar para /opt/dez/app/backend/.env (untracked, NUNCA commitar).
# Detalhes e justificativas: docs/plano_deploy.md §11.

APP_NAME="Sistema DEZ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dez.clinicadez.com.br

BUSINESS_TIMEZONE=America/Fortaleza
PUBLIC_BOOKING_HORIZON_DAYS=30
ROUTINE_RETURN_MONTHS=6

# Segredos exclusivos deste servidor — gerar novos, nunca copiar do ambiente de dev.
#   APP_KEY:                 /opt/dez/bin/artisan key:generate
#   IDENTITY_PEPPER:         openssl rand -hex 32
#   MANAGEMENT_TOKEN_SECRET: openssl rand -hex 32
IDENTITY_PEPPER=
MANAGEMENT_TOKEN_SECRET=

# PostgreSQL 16 do próprio servidor (compartilhado com o STG; role isolado).
# NÃO usar localhost: pode resolver para ::1 e falhar de forma intermitente.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sistema_dez
DB_USERNAME=sistema_dez
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# O frontend é servido da MESMA origem, então VITE_API_URL fica vazio no build
# (as chamadas viram relativas: /api/v1/...). Aqui só o necessário para o
# statefulApi() e o CORS reconhecerem a origem.
SANCTUM_STATEFUL_DOMAINS=dez.clinicadez.com.br
FRONTEND_URLS=https://dez.clinicadez.com.br

PORTAL_TTL_DAYS=30
PORTAL_BASE_URL=https://dez.clinicadez.com.br/resultados
BOOKING_BASE_URL=https://dez.clinicadez.com.br/agendar

# Canal WhatsApp (fork AppChat) fica inerte nesta fase.
WHATSAPP_ENABLED=false
APPCHAT_BASE_URL=http://127.0.0.1:3333
APPCHAT_API_KEY=

MT_DUE_WARNING_DAYS=30

# Opcional: sem a chave, a IA do prontuário fica oculta.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Fontes de importação do legado (subidas para o servidor — ver plano §15).
STG_IMPORT_PATH=/opt/dez/_import/stg
STG_LAUDOS_PATH=/opt/dez/_import/laudos

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
